# 如站方提供 Bearer 凭据，可在云环境设置中安全配置；不要提交真实值。
AMAE_BEARER_TOKEN=
# 系统 Chromium 路径；留空则自动查找。
CHROMIUM_PATH=
# 逐场提交最小间隔（秒），遵守站点要求；遇到限流会暂停。
MORTAL_INTERVAL=15
MORTAL_TIMEOUT=300
# 等待网站自身人机验证回调的时间；不绕过验证。
MORTAL_VERIFICATION_TIMEOUT=15
# 网站更新后，经人工确认控件再设置选择器。
MORTAL_URL_SELECTOR=
MORTAL_SUBMIT_SELECTOR=
# 切换模型/服务版本时更换命名空间，或在界面勾选“忽略缓存”。
MORTAL_CACHE_TAG=official-web-v2
# 与官网模型选择一致；同一批图表保持固定模型。
MORTAL_MODEL_TAG=4.1b
# 默认无头；在有桌面环境的本地机器可设置为 0。
MORTAL_HEADLESS=1
